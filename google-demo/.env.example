# Copy to .env, fill in, then: set -a && source .env && set +a
# Terraform auto-reads TF_VAR_<name> as the value for variable "<name>",
# so this is the .env equivalent for the two password variables.

TF_VAR_db_password=change-me
TF_VAR_datastream_db_password=change-me-too

# Not a Terraform var — Cloud SQL creates the `postgres` superuser with
# no password. Set this after apply via gcloud (step 4.5 below), then
# use it to run sql/setup_source.sql.
POSTGRES_PASSWORD=change-me-three
